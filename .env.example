# Copy to .env and fill in. Get a key at https://console.groq.com
GROQ_API_KEY=gsk_...

# The agent (vetra/) can use any OpenAI-compatible service instead. Models are tried in
# order when one is rate-limited. RTI (rag/) stays on Groq for now.
# Options, prices and setup: docs/LLM_PROVIDERS.md
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=...
# LLM_MODEL_PLAN=small-model,fallback-model
# LLM_MODEL_COMPOSE=large-model,fallback-model
# LLM_REASONING=large-model:none
