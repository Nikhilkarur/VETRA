{"id": "ap-pmfby-premium-rule", "store": "rules", "domain": "agriculture", "jurisdiction": "AP", "subject": "crop insurance PMFBY premium farmer share", "text": "Crop insurance PMFBY: what a farmer pays as premium in Andhra Pradesh, from Rabi 2024-25 onwards, extended to 2026-27 on the same terms. Enrolment is voluntary. The farmer's share is limited further if the actuarial premium rate is lower.", "season": "Rabi 2024-25 onwards", "status": "in_force", "legal_weight": "go", "reviewed": false, "inputs": {"crop_class": ["foodgrain_or_oilseed", "commercial_or_horticulture"], "season": ["kharif", "rabi"]}, "cases": [{"when": {"crop_class": "commercial_or_horticulture"}, "outcome": {"farmer_premium_percent_of_sum_insured": 5}, "label": "Commercial or horticulture crops, either season"}, {"when": {"crop_class": "foodgrain_or_oilseed", "season": "rabi"}, "outcome": {"farmer_premium_percent_of_sum_insured": 1.5}, "label": "Foodgrain or oilseed crops, Rabi season"}, {"when": {"crop_class": "foodgrain_or_oilseed", "season": "kharif"}, "outcome": {"farmer_premium_percent_of_sum_insured": 2}, "label": "Foodgrain or oilseed crops, Kharif season"}], "source": {"doc": "G.O.Ms.No.80 (2024), extended by G.O.Ms.No.34 (2026)", "date": "2024-09-04", "url": "https://goir.ap.gov.in/dgo.ashx?gid=478685&fileType=E"}, "aliases": {"crop_class": {"paddy": "foodgrain_or_oilseed", "rice": "foodgrain_or_oilseed", "wheat": "foodgrain_or_oilseed", "maize": "foodgrain_or_oilseed", "jowar": "foodgrain_or_oilseed", "bajra": "foodgrain_or_oilseed", "ragi": "foodgrain_or_oilseed", "red gram": "foodgrain_or_oilseed", "green gram": "foodgrain_or_oilseed", "black gram": "foodgrain_or_oilseed", "bengal gram": "foodgrain_or_oilseed", "groundnut": "foodgrain_or_oilseed", "sunflower": "foodgrain_or_oilseed", "sesame": "foodgrain_or_oilseed", "foodgrain": "foodgrain_or_oilseed", "oilseed": "foodgrain_or_oilseed", "cotton": "commercial_or_horticulture", "sugarcane": "commercial_or_horticulture", "chilli": "commercial_or_horticulture", "turmeric": "commercial_or_horticulture", "banana": "commercial_or_horticulture", "mango": "commercial_or_horticulture", "cashew": "commercial_or_horticulture", "cashew nut": "commercial_or_horticulture", "tomato": "commercial_or_horticulture", "onion": "commercial_or_horticulture", "commercial": "commercial_or_horticulture", "horticulture": "commercial_or_horticulture"}}, "scheme_words": ["pmfby", "fasal bima", "yield based", "yield-based"], "name": "PMFBY", "render": "the farmer pays {farmer_premium_percent_of_sum_insured}% of the sum insured", "note": "PMFBY premium rule for Andhra Pradesh, from Rabi 2024-25 onwards and extended to 2026-27 on the same terms. Enrolment is voluntary. The farmer's share is limited further if the actuarial rate is lower."}
